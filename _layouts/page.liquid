---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% if page.title and page.no_title != true %}
    <header class="post-header">
      <div class="page-head">
        <h1 class="post-title">{{ page.title }}</h1>
        {% if page.page_count %}
          <span class="blog-count">{{ page.page_count }}</span>
        {% endif %}
      </div>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
        <hr>
      {% endif %}
    </header>
  {% endif %}
  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
