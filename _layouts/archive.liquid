---
layout: default
---
{% if page.type == 'categories' %}
  {% assign archive_title = page.title %}
  {% assign archive_description = 'Posts in this category.' %}
{% elsif page.type == 'tags' %}
  {% assign archive_title = page.title | prepend: '#' %}
  {% assign archive_description = 'Posts with this tag.' %}
{% else %}
  {% assign archive_title = page.date | date: '%Y' %}
  {% assign archive_description = 'Posts from this year.' %}
{% endif %}

<div class="post">
  {% include page_header.liquid title=archive_title description=archive_description count="documents" %}

  <article class="archive">
    <ul class="date-list">
      {% for document in page.documents %}
        <li>
          <time datetime="{{ document.date | date_to_xmlschema }}">{{ document.date | date: '%b %-d, %Y' }}</time>
          <div>
            {% if document.redirect == blank %}
              <a class="post-link" href="{{ document.url | relative_url }}">{{ document.title }}</a>
            {% elsif document.redirect contains '://' %}
              <a class="post-link" href="{{ document.redirect }}" target="_blank">{{ document.title }}</a>
            {% else %}
              <a class="post-link" href="{{ document.redirect | relative_url }}">{{ document.title }}</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
    <p class="archive-back"><a href="{{ '/blog/' | relative_url }}">&larr; All posts</a></p>
  </article>
</div>
