---
layout: default
---
{% unless site.data.resume %}
  <div class="post">
    <header class="post-header cv-header">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.cv_pdf %}
        <a
          class="cv-download"
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="fa-solid fa-file-pdf"></i> Download CV (PDF)
        </a>
      {% endif %}
    </header>

    <article>
      {% if page.cv_pdf %}
        <div class="cv-pdf-embed">
          <iframe
            {% if page.cv_pdf contains '://' %}
              src="{{ page.cv_pdf }}"
            {% else %}
              src="{{ page.cv_pdf | relative_url }}"
            {% endif %}
            title="CV PDF"
            loading="lazy"
          ></iframe>
          <noscript>
            <div class="cv-pdf-fallback">
              <p>PDF viewer unavailable. <a href="{{ page.cv_pdf | relative_url }}" target="_blank">Download CV (PDF)</a></p>
            </div>
          </noscript>
        </div>
      {% endif %}
    </article>
  </div>
{% else %}
  <div class="post">
    <header class="post-header cv-header">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.cv_pdf %}
        <a
          class="cv-download"
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="fa-solid fa-file-pdf"></i> Download CV (PDF)
        </a>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {% for data in site.data.resume %}
          {% if site.jsonresume and site.jsonresume.size > 0 %}
            {% unless site.jsonresume contains data[0] %}
              {% continue %}
            {% endunless %}
          {% endif %}
          {% if data[0] == 'meta' or data[1].size == 0 %} {% continue %} {% endif %}
          <a class="anchor" id="{{ data[0] }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ data[0] | capitalize }}</h3>
            <div>
              {% case data[0] %}
                {% when 'basics' %}
                  {% include resume/basics.liquid %}
                {% when 'education' %}
                  {% include resume/education.liquid %}
                {% when 'work' %}
                  {% include resume/work.liquid %}
                {% when 'volunteer' %}
                  {% include resume/volunteer.liquid %}
                {% when 'projects' %}
                  {% include resume/projects.liquid %}
                {% when 'awards' %}
                  {% include resume/awards.liquid %}
                {% when 'skills' %}
                  {% include resume/skills.liquid %}
                {% when 'publications' %}
                  {% include resume/publications.liquid %}
                {% when 'languages' %}
                  {% include resume/languages.liquid %}
                {% when 'interests' %}
                  {% include resume/interests.liquid %}
                {% when 'certificates' %}
                  {% include resume/certificates.liquid %}
                {% when 'references' %}
                  {% include resume/references.liquid %}
                {% else %}

              {% endcase %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% endunless %}
