{% comment %}
  News list. Items live in _news/; optional `type` (paper, post, joined, award, update)
  renders as a label. `limit=true` applies page.announcements.limit (used on the home page).
{% endcomment %}
<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news.size %}
    {% endif %}
    <ul class="date-list{% if include.limit and page.announcements.scrollable %} is-scrollable{% endif %}">
      {% for item in news limit: news_limit %}
        <li>
          <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %Y' }}</time>
          {% if item.type %}<span class="news-chip">{{ item.type }}</span>{% endif %}
          <div>
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
